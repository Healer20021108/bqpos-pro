# 本機 Vite 開發直連 Vision 用；正式環境不使用這個前端變數。
VITE_VISION_API_KEY=your-google-vision-api-key-here

# Netlify Function 正式環境用。請在 Netlify Environment variables 設定，不要提交真實值。
VISION_API_KEY=your-server-side-google-vision-api-key-here
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-here
